# ==========================================
# Zhihu Authentication
# ==========================================

# Paste your browser session cookie here.
# Required for accessing private Zhihu collections.
ZHIHU_COOKIE=

# ==========================================
# Export Options
# ==========================================

# Whether to download images referenced in articles.
# Defaults to false in Phase 1 to prioritize reliable text export.
# true | false
DOWNLOAD_IMAGES=false

# Delay (in seconds) between consecutive requests.
# Helps avoid rate limiting.
REQUEST_DELAY=2

# Maximum number of retries for failed requests.
MAX_RETRY=3
